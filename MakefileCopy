#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(PSL1GHT)),)
$(error "Set PSL1GHT in the environment: export PSL1GHT=$$PS3DEV")
endif

# Guarda o caminho real da raiz do projeto de forma estática
ifeq ($(notdir $(CURDIR)),build)
    ROOT_DIR := $(patsubst %/,%,$(dir $(CURDIR)))
else
    ROOT_DIR := $(CURDIR)
endif

TITLE     := CellFlix
APPID     := CELLFLIX1
CONTENTID := UP0001-$(APPID)_00-0000000000000000
SFOXML    := $(ROOT_DIR)/sfo.xml
ICON0     := $(ROOT_DIR)/data/ICON0.PNG

include $(PSL1GHT)/ppu_rules

TARGET    := $(notdir $(ROOT_DIR))
BUILD     := build
SOURCES   := source
DATA      :=
INCLUDES  := include
PKGDATA   := data

CFLAGS    = -O2 -Wall -mcpu=cell -std=gnu99 $(MACHDEP) $(INCLUDE)
CXXFLAGS  = -O2 -Wall -mcpu=cell -std=gnu++14 $(MACHDEP) $(INCLUDE)

LDFLAGS   = $(MACHDEP) -Wl,-Map,$(notdir $@).map

LIBS      := -lrt -llv2

LIBDIRS   := $(PORTLIBS)

ifneq ($(BUILD),$(notdir $(CURDIR)))

all: pkg

export OUTPUT   := $(CURDIR)/$(BUILD)/$(TARGET)

export VPATH    := $(foreach dir,$(SOURCES),$(ROOT_DIR)/$(dir)) \
                   $(foreach dir,$(DATA),$(ROOT_DIR)/$(dir))

export DEPSDIR  := $(CURDIR)/$(BUILD)

export BUILDDIR := $(CURDIR)/$(BUILD)

export PKGFILES := $(ROOT_DIR)/$(PKGDATA)

CFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(ROOT_DIR)/$(dir)/*.c)))
CPPFILES  := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(ROOT_DIR)/$(dir)/*.cpp)))
sFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(ROOT_DIR)/$(dir)/*.s)))
SFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(ROOT_DIR)/$(dir)/*.S)))
BINFILES  := $(foreach dir,$(DATA),$(notdir $(wildcard $(ROOT_DIR)/$(dir)/*.*)))

ifeq ($(strip $(CPPFILES)),)
    export LD := $(CC)
else
    export LD := $(CXX)
endif

export OFILES := $(addsuffix .o,$(BINFILES)) \
                 $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) \
                 $(sFILES:.s=.o) $(SFILES:.S=.o)

export INCLUDE := $(foreach dir,$(INCLUDES), -I$(ROOT_DIR)/$(dir)) \
                  $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                  $(LIBPSL1GHT_INC) \
                  -I$(CURDIR)/$(BUILD)

export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib) \
                   $(LIBPSL1GHT_LIB)

.PHONY: $(BUILD) pkg run clean

$(BUILD):
	@mkdir -p $(BUILD)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(ROOT_DIR)/Makefile

pkg:
	@mkdir -p $(BUILD)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(ROOT_DIR)/Makefile $(OUTPUT).pkg

run: $(BUILD)
	ps3load $(OUTPUT).self

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(ROOT_DIR)/$(TARGET).elf $(ROOT_DIR)/$(TARGET).self $(ROOT_DIR)/$(TARGET).pkg

else

DEPENDS := $(OFILES:.o=.d)

$(OUTPUT).self: $(OUTPUT).elf
$(OUTPUT).elf:  $(OFILES)

%.bin.o: %.bin
	@echo $(notdir $<)
	@$(bin2o)

-include $(DEPENDS)

endif
